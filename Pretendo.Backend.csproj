<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Certificate configuration -->
    <CertificateFileName>pretendo-https.pfx</CertificateFileName>
    <CertificatePassword>c7151e08-47b8-46a8-8bb3-68524f9f2754</CertificatePassword>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.7" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.5" />
  </ItemGroup>
 <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
<!-- Generate certificate only during publish -->
  <Target Name="GenerateCertificate" BeforeTargets="Publish" Condition="'$(PublishProtocol)' != '' OR '$(PublishUrl)' != '' OR '$(IsPublishing)' == 'true'">
        
    <Message Text="Generating HTTPS certificate for Windows Service..." Importance="high" />
    <Message Text="Using certificate password from environment variable: $(CertificatePassword)" Importance="high"/>

    <!-- Export certificate to publish directory -->
    <Exec Command="dotnet dev-certs https -ep &quot;$(PublishDir)$(CertificateFileName)&quot; -p $(CertificatePassword)" 
          ContinueOnError="false" />
    
    <Message Text="Certificate generated: $(PublishDir)$(CertificateFileName)" Importance="high" />
  </Target>
</Project>
